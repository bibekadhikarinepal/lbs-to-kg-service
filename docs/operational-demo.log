[PASS] /convert?lbs=150 returns 200 - status=200
[PASS] /convert?lbs=150 kg is 68.039 - {"lbs":150,"kg":68.039,"formula":"kg = lbs * 0.45359237"}
[PASS] /convert?lbs=0.1 returns 200 - status=200
